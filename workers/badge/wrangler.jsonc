// KYA-OS conformance badge worker - Cloudflare configuration.
//
// NOT DEPLOYABLE YET. Phase A of the conformance program has not issued any
// real credentials, the pinned issuer keys in worker.mjs are placeholders,
// and the Cloudflare project does not exist. The route below stays commented
// out until all three are true - see README.md for the one-time setup.
{
  "name": "kya-os-badge",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false

  // One-time setup (Phase B): create the Cloudflare Worker project, replace
  // the placeholder issuer keys and the suite-manifest URL in worker.mjs with
  // the Phase A values, then uncomment the route below. It is a ZONE route
  // (not a custom domain), so the worker takes over /badge/* on the builders
  // host while Cloudflare Pages keeps serving every other path - the static
  // badge tiers hand the same URLs to the worker with no embed churn. Zone
  // routes require zone_name (the kya-os.org zone in the DIF account).
  //
  // "routes": [
  //   { "pattern": "builders.kya-os.org/badge/*", "zone_name": "kya-os.org" }
  // ]
}
